# Sirru AI Workspace - Environment Configuration
# Copy this file to .env and configure for your deployment
#
# For Coolify deployment:
# 1. Copy these variables to Coolify's environment configuration
# 2. Set WEBUI_SECRET_KEY (required)
# 3. Configure your AI backend (Ollama or OpenAI)

# ============================================
# CORE SETTINGS (REQUIRED)
# ============================================

# Application version
SIRRU_VERSION=latest

# Port to expose Sirru (default: 8080)
SIRRU_PORT=8080

# Application name (displayed in UI)
WEBUI_NAME=Sirru

# Public URL (important for OAuth redirects and sharing)
WEBUI_URL=https://your-domain.com

# Secret key for session encryption (REQUIRED)
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# ============================================
# DATABASE
# ============================================

# SQLite (default) - no configuration needed
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://sirru:password@postgres:5432/sirru

# PostgreSQL credentials (if using with-postgres profile)
POSTGRES_USER=sirru
POSTGRES_PASSWORD=
POSTGRES_DB=sirru

# ============================================
# AUTHENTICATION
# ============================================

# Allow new user signups
ENABLE_SIGNUP=true

# Default role for new users (user, pending, admin)
DEFAULT_USER_ROLE=user

# Enable OAuth/SSO signup
ENABLE_OAUTH_SIGNUP=false

# OAuth Settings (for enterprise SSO)
# Supports: Google, Microsoft, GitHub, or any OIDC provider
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENID_PROVIDER_URL=

# ============================================
# AI BACKENDS
# ============================================

# Ollama (local AI inference for air-gapped deployments)
# - Use http://ollama:11434 when using docker-compose with ollama service
# - Use http://host.docker.internal:11434 for Ollama running on host
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI Compatible API (optional, for cloud-connected deployments)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# ============================================
# RAG & EMBEDDINGS (Docs AI)
# ============================================

# Embedding model for document search
# Default: sentence-transformers/all-MiniLM-L6-v2 (~90MB)
# Multilingual: intfloat/multilingual-e5-base (~1.5GB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Document chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# GPU / CUDA SUPPORT
# ============================================

# Enable CUDA for GPU acceleration
USE_CUDA=false

# Include Ollama in the Docker image
USE_OLLAMA=false

# ============================================
# SECURITY & COMPLIANCE
# ============================================

# Admin permissions
ENABLE_ADMIN_EXPORT=true
ENABLE_ADMIN_CHAT_ACCESS=false

# CORS configuration (restrict in production)
CORS_ALLOW_ORIGIN=*

# Proxy configuration
FORWARDED_ALLOW_IPS=*

# Telemetry disabled for sovereign deployments
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
